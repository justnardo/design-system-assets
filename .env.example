# design-system-assets — environment variables
#
# Copy this file to `.env` in your project root and fill in your keys.
# Add `.env` to `.gitignore` to avoid committing secrets.
#
# See references/byok_setup.md for where to get each key.

# OpenAI: required for the default image provider (gpt-image-1)
OPENAI_API_KEY=sk-proj-...

# Anthropic: required for the asset review step (Claude vision)
ANTHROPIC_API_KEY=sk-ant-...

# Gemini: optional alternative image provider
# GEMINI_API_KEY=AIza...
